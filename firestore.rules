rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Matches the user's main profile document
    match /users/{userId} {
      // 1. Only allows reading/writing if the logged-in user's UID matches the document ID
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 2. Covers every subcollection nested under this user (playlists, continueWatching,
      //    and anything added later) instead of allowlisting each one by name.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

  }
}
